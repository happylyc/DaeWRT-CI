#!/bin/sh
# ============================================================
# OpenWrt 首次启动自动配置脚本（ddns-go + 端口转发版）
# ============================================================

PPPOE_USER='__PPPOE_USER__'
PPPOE_PASS='__PPPOE_PASS__'
DDNS_DOMAIN='__DDNS_DOMAIN__'
DDNS_TOKEN='__DDNS_TOKEN__'

# 路由器 LAN 地址
LAN_IP='192.168.10.1'

# ============================================================
# 1. 网络配置（PPPoE）
# ============================================================
echo "[Setup] 配置 PPPoE..."
uci set network.wan=interface
uci set network.wan.device='eth0'
uci set network.wan.proto='pppoe'
uci set network.wan.username="$PPPOE_USER"
uci set network.wan.password="$PPPOE_PASS"
uci set network.wan.ipv6='auto'
uci commit network

# ============================================================
# 2. DDNS-Go 配置
# ============================================================
echo "[Setup] 配置 ddns-go..."

mkdir -p /etc/ddns-go

cat > /etc/ddns-go/config.yaml << EOF
ipv4:
  enable: true
  gettype: url
  url: https://myip.ipip.net,https://ddns.oray.com/checkip,https://ip.3322.net,https://4.ipw.cn
  domains:
    - $DDNS_DOMAIN

ipv6:
  enable: false

dns:
  name: cloudflare
  id: ""
  secret: $DDNS_TOKEN

ttl: 300
EOF

uci set ddns-go.basic=basic
uci set ddns-go.basic.enabled='1'
uci set ddns-go.basic.port='9876'
uci set ddns-go.basic.logoff='1'
uci set ddns-go.basic.log_stdout='1'
uci commit ddns-go

# ============================================================
# 3. 防火墙：端口转发（外网非标准端口 → 路由器）
# ============================================================
echo "[Setup] 配置端口转发..."

add_redirect() {
    local name="$1" src_port="$2" dest_ip="$3" dest_port="$4" proto="${5:-tcp}"
    if ! uci show firewall | grep -q "name='$name'"; then
        uci add firewall redirect >/dev/null 2>&1
        uci set firewall.@redirect[-1].name="$name"
        uci set firewall.@redirect[-1].src='wan'
        uci set firewall.@redirect[-1].src_dport="$src_port"
        uci set firewall.@redirect[-1].dest='lan'
        uci set firewall.@redirect[-1].dest_ip="$dest_ip"
        uci set firewall.@redirect[-1].dest_port="$dest_port"
        uci set firewall.@redirect[-1].proto="$proto"
        uci set firewall.@redirect[-1].target='DNAT'
        echo "[Setup] 已添加转发: $name (外网:$src_port → $dest_ip:$dest_port)"
    fi
}

# 外网 1008 → 路由器 80 (LuCI)
add_redirect 'PortForward-LuCI'  '1008'  "$LAN_IP"  '80'   'tcp'

# 外网 2222 → 路由器 22 (SSH)
add_redirect 'PortForward-SSH'   '2222'  "$LAN_IP"  '22'   'tcp'

uci commit firewall

# ============================================================
# 4. 重启服务
# ============================================================
echo "[Setup] 重启网络服务..."
/etc/init.d/network restart
sleep 3
/etc/init.d/firewall restart

/etc/init.d/ddns-go enable
/etc/init.d/ddns-go restart

echo "[Setup] 配置完成！"
echo "[Setup] 外网访问: http://$DDNS_DOMAIN:1008 (LuCI)"
echo "[Setup] SSH 访问: ssh -p 2222 root@$DDNS_DOMAIN"

exit 0
