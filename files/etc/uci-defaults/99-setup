#!/bin/sh
# ============================================================
# OpenWrt 首次启动自动配置脚本（安全占位符注入版）
# ============================================================

PPPOE_USER='__PPPOE_USER__'
PPPOE_PASS='__PPPOE_PASS__'
DDNS_DOMAIN='__DDNS_DOMAIN__'
DDNS_TOKEN='__DDNS_TOKEN__'
ROOT_PASS='__ROOT_PASS__'

# WiFi 密码统一一个
WIFI_KEY='__WIFI_KEY__'

# SSID（按你提供的三射频）
WIFI_SSID_2G='__WIFI_SSID_2G__'
WIFI_SSID_5G1='__WIFI_SSID_5G1__'
WIFI_SSID_5G2='__WIFI_SSID_5G2__'

# ============================================================
# 1. 设置 root 密码
# ============================================================
echo "[Setup] 设置 root 密码..."
echo "root:${ROOT_PASS}" | chpasswd

# ============================================================
# 2. PPPoE 拨号配置（使用正确设备 wan）
# ============================================================
echo "[Setup] 配置 PPPoE..."
uci set network.wan.device='wan'
uci set network.wan.proto='pppoe'
uci set network.wan.username="$PPPOE_USER"
uci set network.wan.password="$PPPOE_PASS"
uci set network.wan.ipv6='auto'
uci commit network

# ============================================================
# 3. 写入 ddns-go YAML（Secrets 注入）
# ============================================================
echo "[Setup] 写入 ddns-go YAML..."

mkdir -p /etc/ddns-go

cat > /etc/ddns-go/ddns-go-config.yaml <<EOF
dnsconf:
  - name: ""
    ipv4:
      enable: true
      gettype: url
      url: https://ddns.oray.com/checkip, https://ip.3322.net, https://4.ipw.cn, https://v4.yinghualuo.cn/bejson, https://myip.ipip.net
      netinterface: br-lan
      cmd: ""
      domains:
        - ${DDNS_DOMAIN}
    ipv6:
      enable: false
      gettype: netInterface
      url: https://speed.neu6.edu.cn/getIP.php, https://v6.ident.me, https://6.ipw.cn, https://v6.yinghualuo.cn/bejson
      netinterface: br-lan
      cmd: ""
      ipv6reg: ""
      domains: []
    dns:
      name: cloudflare
      id: ""
      secret: ${DDNS_TOKEN}
      extparam: ""
    ttl: ""
    httpinterface: ""
user:
  username: happylyc
  password: \$2a\$10\$7Ppo5w59nVasaQ.I9rEdWOo8bIoJhIcioZPyz5MHHQ.6Js2LU7NjG
webhook:
  webhookurl: ""
  webhookrequestbody: ""
  webhookheaders: ""
notallowwanaccess: true
lang: en
EOF

# ============================================================
# 4. 写入 ddns-go UCI（启用 YAML 模式）
# ============================================================
echo "[Setup] 写入 ddns-go UCI..."

cat > /etc/config/ddns-go <<EOF
config basic 'config'
  option enabled '1'
  option logger '1'
  option port '9876'
  option delay '0'
  option dns '223.5.5.5'
  option noweb '0'
  option yaml '1'
  option yamlpath '/etc/ddns-go/ddns-go-config.yaml'
EOF

# ============================================================
# 5. 写入无线配置（严格按你提供的三射频）
# ============================================================
echo "[Setup] 写入无线配置..."

cat > /etc/config/wireless <<EOF
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '5g'
	option channel '144'
	option htmode 'HE80'
	option country 'US'
	option cell_density '0'
	option txpower '24'
	option disabled '1'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid '${WIFI_SSID_5G2}'
	option encryption 'psk2+ccmp'
	option key '${WIFI_KEY}'
	option disabled '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi+1'
	option band '2g'
	option channel '11'
	option htmode 'HE20'
	option country 'US'
	option txpower '24'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid '${WIFI_SSID_2G}'
	option encryption 'psk2+ccmp'
	option key '${WIFI_KEY}'
	option disabled '0'

config wifi-device 'radio2'
	option type 'mac80211'
	option path 'soc@0/20000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '5g'
	option channel '44'
	option htmode 'HE80'
	option country 'US'
	option txpower '24'
	option cell_density '0'

config wifi-iface 'default_radio2'
	option device 'radio2'
	option network 'lan'
	option mode 'ap'
	option ssid '${WIFI_SSID_5G1}'
	option encryption 'psk2+ccmp'
	option key '${WIFI_KEY}'
	option disabled '0'
EOF

# ============================================================
# 6. 重启服务
# ============================================================
echo "[Setup] 重启服务..."
/etc/init.d/network restart
/etc/init.d/firewall restart
wifi reload
/etc/init.d/ddns-go enable
/etc/init.d/ddns-go restart

exit 0
